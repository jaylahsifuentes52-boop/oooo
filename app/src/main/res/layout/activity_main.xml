<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TvPatcher"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manual Gorilla Tag patch utility"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/otpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="OTP Verification"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/headsetInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Headset identifier"
            android:inputType="text" />

        <Button
            android:id="@+id/requestOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Request OTP" />

        <TextView
            android:id="@+id/requestCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Request code: —"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/otpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter OTP from Discord"
            android:inputType="number"
            android:maxLength="6" />

        <Button
            android:id="@+id/verifyOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Verify OTP" />

        <Button
            android:id="@+id/grantPatchAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Grant Patch Access" />

        <TextView
            android:id="@+id/authInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="NEEDS AUTH GO INTO GTAG AND STAY INTO A LOBBY FOR 15-30 SECONDS FOR AUTH"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/copyObb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Copy OBB"
            android:enabled="false" />

        <TextView
            android:id="@+id/obbDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Copies OBB files from normal Gorilla Tag to modded Gorilla Tag and renames the package in the filenames."
            android:textSize="14sp" />

        <Button
            android:id="@+id/restoreCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Restore Cache"
            android:enabled="false" />

        <TextView
            android:id="@+id/cacheDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Copies the normal Gorilla Tag cache into the modded Gorilla Tag cache."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Tap Grant Patch Access."
            android:textSize="16sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
